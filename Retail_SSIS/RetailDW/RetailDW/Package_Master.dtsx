              SQLTask:SqlStatementSource="INSERT INTO ETL.AuditLog&#xA;(&#xA;    PackageName,&#xA;    FileName,&#xA;    StartTime,&#xA;    Status&#xA;)&#xA;VALUES&#xA;(&#xA;    'Master Package',&#xA;    ?,&#xA;    GETDATE(),&#xA;    'Running'&#xA;);&#xA;&#xA;SELECT CAST(SCOPE_IDENTITY() AS INT) AS RunID;"
